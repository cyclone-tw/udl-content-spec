{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:udl-content-spec:v1:activity-profile",
  "title": "年級活動設定",
  "description": "某科某些年級，一課預設有哪些步驟（關卡）、各屬讀委託／修練／討伐哪一段。單元綁了什麼卡、有什麼教材，決定哪些步驟真的出現（planSteps）。老師之後可在指派時隱藏或調整順序。",
  "type": "object",
  "required": ["format_version", "id", "title", "subject", "grades", "steps"],
  "properties": {
    "format_version": { "const": 1 },
    "id": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "subject": { "$ref": "urn:udl-content-spec:v1:common#/$defs/subject" },
    "grades": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 12 } },
    "steps": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/step" } },
    "ladders": {
      "type": "object",
      "description": "活動 × 年級 → 能力階梯：卡片生的題優先用這裡的 ladder_ids（同一張卡拿去不同活動練的是不同能力）。鍵是活動 id；值的鍵是年級（\"1\"–\"12\"）或 \"*\"（其他年級）。單元的 ladders 可覆寫。",
      "propertyNames": { "$ref": "#/$defs/activity_id" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "pattern": "^([1-9]|1[0-2]|\\*)$" },
        "additionalProperties": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:udl-content-spec:v1:common#/$defs/ladder_id" } }
      }
    },
    "ladder_status": { "type": "string", "enum": ["draft", "reviewed"], "description": "ladders 對照是否已由 Cyclone 審過；draft 時驗證器只提醒。" }
  },
  "additionalProperties": false,
  "$defs": {
    "step": {
      "type": "object",
      "required": ["activity", "label"],
      "properties": {
        "activity": { "$ref": "#/$defs/activity_id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 8, "description": "進度條上的名稱（低年級用兩三個字）。" },
        "short": { "type": "string", "minLength": 1, "maxLength": 3, "description": "窄螢幕的短名；省略就用 label。" },
        "phase": { "type": "string", "enum": ["learn", "practice", "battle"], "description": "讀委託／修練／討伐；省略就用活動預設。" },
        "count": {
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 30 }, { "const": "all" }],
          "description": "生題活動的題數；省略用活動預設。\"all\"：題庫有幾筆就出幾題，每筆輪到一次（練習用，#50）。"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/activity_id" },
          "description": "只給 mix：這一步混合哪些同分類的生題活動（#51）。例如課文練習混合段落大意、心智圖、手寫課文題。"
        },
        "blueprint": {
          "type": "array",
          "minItems": 1,
          "description": "只給 quiz：測驗藍圖，各練習分類抽幾題（#50）。題目只從本課練習步驟同分類的活動抽；有藍圖時 count 由藍圖加總。",
          "items": {
            "type": "object",
            "required": ["group", "count"],
            "properties": {
              "group": { "$ref": "#/$defs/group" },
              "count": { "type": "integer", "minimum": 1, "maximum": 30 }
            },
            "additionalProperties": false
          }
        },
        "optional": { "type": "boolean", "description": "老師指派時可以關掉的步驟。" },
        "read_aloud_scope": { "type": "string", "enum": ["all", "stem", "none"], "description": "覆寫活動預設的報讀範圍。" }
      },
      "additionalProperties": false
    },
    "group": {
      "type": "string",
      "enum": ["char", "word", "reading", "skill"],
      "description": "練習分類（#50）：char 識字、word 語詞、reading 課文、skill 數學技能。"
    },
    "activity_id": {
      "type": "string",
      "enum": ["read", "mindmap", "demo", "char-cards", "word-cards", "manipulate", "char-pick", "word-match", "word-cloze", "listen-char", "listen-word", "tone-pick", "char-lookalike", "char-trace", "char-write", "word-meaning", "reading-items", "para-gist", "para-order", "mindmap-pick", "mindmap-order", "rhetoric-pick", "rhetoric-sort", "mix", "sentence-order", "skill-practice", "quiz"],
      "description": "活動 id，對應 activities/index.mjs 的登錄表。"
    }
  }
}
