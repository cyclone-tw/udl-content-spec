{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:udl-content-spec:v1:pack",
  "title": "pack.json 內容包名片",
  "description": "一個內容包的根檔。目錄慣例：units/<id>.json、materials/<id>.json、items/<id>.json、pools/<id>.json，媒體放 audio/、images/。",
  "type": "object",
  "required": ["format_version", "id", "version", "title", "subject", "language", "license", "source", "units", "files"],
  "properties": {
    "format_version": { "const": 1 },
    "id": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id" },
    "version": { "$ref": "urn:udl-content-spec:v1:common#/$defs/semver" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "subject": { "$ref": "urn:udl-content-spec:v1:common#/$defs/subject" },
    "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$", "description": "例如 zh-TW。" },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "內容授權，例如 CC-BY-4.0；含課文原句的包須標 proprietary 且不可公開。"
    },
    "source": {
      "type": "object",
      "required": ["generated_by", "date"],
      "properties": {
        "generated_by": { "type": "string", "minLength": 1, "description": "產生者：agent 名稱或人。" },
        "date": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "default_voice": { "type": "string", "minLength": 1, "description": "預設 zh-TW-HsiaoChenNeural。" }
      },
      "additionalProperties": false
    },
    "units": {
      "type": "array",
      "description": "單元清單；只放卡片的卡片庫包可以是空陣列（此時 cards 至少一張，驗證器檢查）。",
      "items": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id" },
      "minItems": 0,
      "uniqueItems": true
    },
    "cards": {
      "type": "array",
      "description": "本包的卡片（cards/<id>.json）；卡片庫包與一般課包都可以帶卡。",
      "items": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id" },
      "uniqueItems": true,
      "default": []
    },
    "pools": {
      "type": "array",
      "description": "包層級的干擾項池清單；池可被多個單元共用，單元的 pools 與題目的 distractor_pool 只能引用這裡列出的池。",
      "items": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id" },
      "uniqueItems": true,
      "default": []
    },
    "misconceptions": {
      "type": "object",
      "description": "錯誤類型代碼表（#43）：代碼 → 給老師看的中文名。選擇題錯誤選項的 misconception 只能用這裡列出的代碼；教師報表據此把代碼翻成中文。",
      "propertyNames": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "description": "給老師看的中文名，例如「看到動詞就以為是擬人」。" },
          "note": { "type": "string", "description": "給老師或出題者的補充說明。" }
        },
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "description": "包內除 pack.json 以外的每個檔案與 sha256；用 update-files 產生。",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "$ref": "urn:udl-content-spec:v1:common#/$defs/relative_path" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
