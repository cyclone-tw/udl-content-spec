{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:udl-content-spec:v1:unit",
  "title": "Unit 單元",
  "description": "對齊教科書或課綱的一段內容（一課、一小單元）。只放對齊資訊與引用，不放教材本文。",
  "type": "object",
  "required": ["format_version", "id", "title", "subject", "grade", "materials", "items"],
  "properties": {
    "format_version": { "const": 1 },
    "id": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "subject": { "$ref": "urn:udl-content-spec:v1:common#/$defs/subject" },
    "grade": { "type": "integer", "minimum": 1, "maximum": 12 },
    "semester": { "type": "string", "enum": ["上", "下"] },
    "alignment": {
      "type": "object",
      "description": "教科書對齊；文本仍須原創，只對齊進度。",
      "properties": {
        "publisher": { "type": "string", "minLength": 1 },
        "lesson": { "type": "integer", "minimum": 1 },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ladder_ids": { "type": "array", "items": { "$ref": "urn:udl-content-spec:v1:common#/$defs/ladder_id" }, "uniqueItems": true },
    "curriculum_codes": { "type": "array", "items": { "$ref": "urn:udl-content-spec:v1:common#/$defs/curriculum_code" }, "uniqueItems": true },
    "estimated_minutes": { "type": "integer", "minimum": 1 },
    "materials": { "type": "array", "items": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id" }, "uniqueItems": true },
    "items": { "type": "array", "items": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id" }, "uniqueItems": true },
    "pools": { "type": "array", "items": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id" }, "uniqueItems": true },
    "bindings": {
      "type": "object",
      "description": "這課綁了哪些卡（同包 id 或跨包 pack@version#id）；練習與測驗依這裡的卡生題（activities/）。",
      "properties": {
        "chars": { "type": "array", "items": { "$ref": "urn:udl-content-spec:v1:common#/$defs/card_ref" }, "uniqueItems": true },
        "words": { "type": "array", "items": { "$ref": "urn:udl-content-spec:v1:common#/$defs/card_ref" }, "uniqueItems": true },
        "patterns": { "type": "array", "items": { "$ref": "urn:udl-content-spec:v1:common#/$defs/card_ref" }, "uniqueItems": true },
        "skills": { "type": "array", "items": { "$ref": "urn:udl-content-spec:v1:common#/$defs/card_ref" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "core": {
      "type": "array",
      "description": "核心卡：bindings 之中這課最重要的那些（減量、簡化、寫字只練一部分時用）；標在每課清單，不放卡片本身。",
      "items": { "$ref": "urn:udl-content-spec:v1:common#/$defs/card_ref" },
      "uniqueItems": true
    },
    "ladders": {
      "type": "object",
      "description": "覆寫年級活動設定的 ladders：活動 id → 這課該活動練的能力階梯。",
      "propertyNames": { "$ref": "urn:udl-content-spec:v1:activity-profile#/$defs/activity_id" },
      "additionalProperties": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:udl-content-spec:v1:common#/$defs/ladder_id" } }
    },
    "quest": {
      "type": "object",
      "description": "任務包裝：開場與回報對話（同單元的 dialogue 教材）。RPG 殼接成任務；獨立殼可以忽略。",
      "properties": {
        "intro": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id" },
        "outro": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id" }
      },
      "additionalProperties": false
    },
    "activity_profile": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id", "description": "指定年級活動設定（activities/profiles/）；省略就依科目與年級自動選。" },
    "activities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "description": "這課自己的步驟清單，整份取代年級活動設定（少用）。",
      "items": { "$ref": "urn:udl-content-spec:v1:activity-profile#/$defs/step" }
    }
  },
  "additionalProperties": false
}
