{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:udl-content-spec:v1:generators/profile/congruent-triangles",
  "title": "能力指標出題條件檔（math.congruent-triangles）",
  "description": "全等與對應：kind=find 找出和甲全等的三角形（一張圖放甲與 ①–④）；kind=correspond 找對應邊或對應角（甲 ㄅㄆㄇ、乙 ㄉㄊㄋ）。",
  "type": "object",
  "required": [
    "format_version",
    "ladder_id",
    "ladder_ref",
    "generator",
    "generator_version",
    "tiers",
    "defaults",
    "adjustments",
    "hints",
    "feedback",
    "stems",
    "alt"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "ladder_id": {
      "$ref": "urn:udl-content-spec:v1:common#/$defs/ladder_id"
    },
    "ladder_ref": {
      "$ref": "urn:udl-content-spec:v1:generators/profile/add-sub#/properties/ladder_ref"
    },
    "generator": {
      "const": "math.congruent-triangles"
    },
    "generator_version": {
      "type": "integer",
      "minimum": 1
    },
    "tiers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "urn:udl-content-spec:v1:common#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "kind"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "find",
              "correspond"
            ]
          },
          "flip": {
            "type": "boolean",
            "description": "kind=find：全等的那一個是翻過來的。"
          },
          "ask": {
            "type": "string",
            "enum": [
              "side",
              "angle"
            ],
            "description": "kind=correspond：問對應邊或對應角。"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "find"
                }
              }
            },
            "then": {
              "required": [
                "flip"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "correspond"
                }
              }
            },
            "then": {
              "required": [
                "ask"
              ]
            }
          }
        ]
      }
    },
    "defaults": {
      "$ref": "#/$defs/settings"
    },
    "adjustments": {
      "type": "object",
      "required": [
        "simplify",
        "reduce",
        "decompose",
        "substitute",
        "not_applicable"
      ],
      "properties": {
        "simplify": {
          "$ref": "#/$defs/adjustment"
        },
        "reduce": {
          "$ref": "#/$defs/adjustment"
        },
        "decompose": {
          "$ref": "#/$defs/adjustment"
        },
        "substitute": {
          "$ref": "#/$defs/adjustment"
        },
        "not_applicable": {
          "$ref": "#/$defs/adjustment"
        }
      },
      "additionalProperties": false
    },
    "hints": {
      "type": "object",
      "description": "檔位 id → 三句提示（輕推 → 縮範圍 → 近答案），可用 {變數}。",
      "propertyNames": {
        "$ref": "urn:udl-content-spec:v1:common#/$defs/id"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "feedback": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "find": {
          "type": "object",
          "required": [
            "correct",
            "retry"
          ],
          "properties": {
            "correct": {
              "type": "string",
              "minLength": 1
            },
            "retry": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "correspond": {
          "type": "object",
          "required": [
            "correct",
            "retry"
          ],
          "properties": {
            "correct": {
              "type": "string",
              "minLength": 1
            },
            "retry": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "stems": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "find": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "type": "string",
          "minLength": 1
        },
        "angle": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "alt": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "find": {
          "type": "string",
          "minLength": 1
        },
        "correspond": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "settings": {
      "type": "object",
      "required": [
        "tiers",
        "weights",
        "count",
        "rotate"
      ],
      "properties": {
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:udl-content-spec:v1:common#/$defs/id"
          },
          "uniqueItems": true
        },
        "weights": {
          "type": "object",
          "propertyNames": {
            "$ref": "urn:udl-content-spec:v1:common#/$defs/id"
          },
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "rotate": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "adjustment": {
      "type": "object",
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "skip": {
          "const": true
        },
        "note": {
          "type": "string"
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:udl-content-spec:v1:common#/$defs/id"
          },
          "uniqueItems": true
        },
        "weights": {
          "type": "object",
          "propertyNames": {
            "$ref": "urn:udl-content-spec:v1:common#/$defs/id"
          },
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "rotate": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
