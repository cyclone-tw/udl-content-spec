{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:udl-content-spec:v1:generators/instance",
  "title": "題目實例（產生器輸出）",
  "description": "instantiate(item, { seed }) 的每一筆輸出。形狀與固定題相同，所以可以直接丟給 question-types 的 score()；多了 kind: instance 與追溯欄位（source_item、generator、generator_version、seed、index、variables）。實例不是內容檔，不存進內容包。",
  "type": "object",
  "required": ["kind", "id", "source_item", "type", "generator", "generator_version", "seed", "index", "variables", "stem", "answer", "hints", "feedback"],
  "properties": {
    "kind": { "const": "instance" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}#[0-9]+$", "description": "<item id>#<index>。" },
    "source_item": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id" },
    "unit": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id" },
    "type": { "type": "string", "enum": ["numeric"], "description": "目前所有產生器都產數值題；新增其他題型的產生器時擴充。" },
    "skill": { "type": "string", "minLength": 1 },
    "difficulty": { "$ref": "urn:udl-content-spec:v1:common#/$defs/difficulty" },
    "ladder_ids": { "type": "array", "items": { "$ref": "urn:udl-content-spec:v1:common#/$defs/ladder_id" } },
    "curriculum_codes": { "type": "array", "items": { "$ref": "urn:udl-content-spec:v1:common#/$defs/curriculum_code" } },
    "strategy": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "generator": { "type": "string", "minLength": 1 },
    "generator_version": { "type": "integer", "minimum": 1 },
    "seed": { "type": "string", "minLength": 1 },
    "index": { "type": "integer", "minimum": 0 },
    "variables": { "type": "object", "additionalProperties": { "type": ["number", "string", "boolean"] }, "description": "產生器抽到的變數，給提示置換與事件記錄。" },
    "stem": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "$ref": "urn:udl-content-spec:v1:common#/$defs/spoken_text" },
        "image": { "$ref": "urn:udl-content-spec:v1:common#/$defs/relative_path" }
      },
      "additionalProperties": false
    },
    "answer": { "type": "number" },
    "tolerance": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "type": "string", "enum": ["nominal", "relative", "geometric"] },
        "value": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 6 }
      },
      "additionalProperties": false
    },
    "unit_label": { "type": "string" },
    "display": {
      "type": "object",
      "properties": { "layout": { "type": "string", "enum": ["horizontal", "vertical"] } },
      "additionalProperties": false
    },
    "hints": { "$ref": "urn:udl-content-spec:v1:common#/$defs/hints" },
    "feedback": { "$ref": "urn:udl-content-spec:v1:common#/$defs/feedback" },
    "meta": { "type": "object" }
  },
  "additionalProperties": false
}
