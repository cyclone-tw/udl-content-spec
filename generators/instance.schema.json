{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:udl-content-spec:v1:generators/instance",
  "title": "題目實例（產生器輸出）",
  "description": "instantiate(item, { seed }) 的每一筆輸出。形狀與固定題相同，所以可以直接丟給 question-types 的 score()；多了 kind: instance 與追溯欄位（source_item、generator、generator_version、seed、index、tier、variables）。實例不是內容檔，不存進內容包。",
  "type": "object",
  "required": ["kind", "id", "source_item", "type", "generator", "generator_version", "seed", "index", "variables", "stem", "hints", "feedback"],
  "properties": {
    "kind": { "const": "instance" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}#[0-9]+$", "description": "<item id>#<index>。" },
    "source_item": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id" },
    "unit": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id" },
    "type": { "type": "string", "enum": ["numeric", "blanks", "choice"], "description": "產生器產數值題、多格填空（直式）或選擇題（幾何圖形題）；新增其他題型的產生器時擴充。" },
    "skill": { "type": "string", "minLength": 1 },
    "difficulty": { "$ref": "urn:udl-content-spec:v1:common#/$defs/difficulty" },
    "ladder_ids": { "type": "array", "items": { "$ref": "urn:udl-content-spec:v1:common#/$defs/ladder_id" } },
    "curriculum_codes": { "type": "array", "items": { "$ref": "urn:udl-content-spec:v1:common#/$defs/curriculum_code" } },
    "strategy": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "generator": { "type": "string", "minLength": 1 },
    "generator_version": { "type": "integer", "minimum": 1 },
    "seed": { "type": "string", "minLength": 1 },
    "index": { "type": "integer", "minimum": 0 },
    "tier": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id", "description": "這題抽到的條件檔檔位（事件要記）。" },
    "variables": { "type": "object", "additionalProperties": { "type": ["number", "string", "boolean"] }, "description": "產生器抽到的變數，給提示置換與事件記錄。" },
    "stem": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "$ref": "urn:udl-content-spec:v1:common#/$defs/spoken_text" },
        "image": { "$ref": "urn:udl-content-spec:v1:common#/$defs/relative_path" }
      },
      "additionalProperties": false
    },
    "answer": { "type": ["number", "string"], "description": "numeric：正解數值；choice：正解選項 id。" },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id" },
          "text": { "$ref": "urn:udl-content-spec:v1:common#/$defs/spoken_text" },
          "misconception": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id", "description": "選到這個錯誤選項時記的錯誤類型代碼（activities 內建表）。" }
        },
        "additionalProperties": false
      }
    },
    "shuffle": { "type": "boolean", "description": "choice：殼可不可以打亂選項順序。有大小順序的選項（比直角小／一樣大／比直角大）設 false。" },
    "tolerance": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "type": "string", "enum": ["nominal", "relative", "geometric"] },
        "value": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "input": { "$ref": "#/$defs/numeric_input" },
    "unit_label": { "type": "string" },
    "blanks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "kind", "answer"],
        "properties": {
          "id": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id" },
          "kind": { "const": "numeric" },
          "answer": { "type": "number" },
          "tolerance": {
            "type": "object",
            "required": ["type", "value"],
            "properties": {
              "type": { "type": "string", "enum": ["nominal", "relative", "geometric"] },
              "value": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "input": { "$ref": "#/$defs/numeric_input" },
          "unit_label": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "read_aloud_scope": {
      "type": "string",
      "enum": ["all", "stem", "none"],
      "description": "報讀範圍：all 題幹與選項都可唸；stem 只唸題幹（識字類選項不唸，否則變成聽音選字）；none 不唸。殼照做，事件照記 read_aloud。省略時殼用預設 all。"
    },
    "display": {
      "type": "object",
      "description": "給 renderer 的呈現提示，不影響計分。",
      "properties": {
        "layout": { "type": "string", "enum": ["horizontal", "vertical"] },
        "operation": { "type": "string", "enum": ["add", "sub"] },
        "operands": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } },
        "places": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string", "enum": ["ones", "tens", "hundreds", "thousands"] }, "description": "直式要畫哪幾位，由低到高；與 blanks 的格一一對應。" },
        "carry_marks": { "type": "boolean", "description": "renderer 可畫進退位記號格；記號不計分。" },
        "scaffold": { "type": "string", "enum": ["none", "partial", "full"], "description": "鷹架檔：none 純直式；partial 位值標籤＋進退位格＋提示；full 再加圖像與逐位閘門。" },
        "figure": { "$ref": "urn:udl-content-spec:v1:figure", "description": "幾何圖形（schema/figure.schema.json）；renderer 畫在題幹旁。" },
        "overlay": { "type": "string", "enum": ["button", "hint", "always"], "description": "疊圖工具（figure.tools）什麼時候出現：button 只給切換鈕；hint 另外在用到第 2 層提示時自動疊上；always 一開始就疊上（課程調整：分解）。" }
      },
      "additionalProperties": false
    },
    "hints": { "$ref": "urn:udl-content-spec:v1:common#/$defs/hints" },
    "feedback": { "$ref": "urn:udl-content-spec:v1:common#/$defs/feedback" },
    "meta": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "numeric" } } },
      "then": { "required": ["answer"], "properties": { "answer": { "type": "number" }, "blanks": false, "options": false, "shuffle": false } }
    },
    {
      "if": { "properties": { "type": { "const": "blanks" } } },
      "then": { "required": ["blanks"], "properties": { "answer": false, "tolerance": false, "input": false, "unit_label": false, "options": false, "shuffle": false } }
    },
    {
      "if": { "properties": { "type": { "const": "choice" } } },
      "then": { "required": ["options", "answer"], "properties": { "answer": { "$ref": "urn:udl-content-spec:v1:common#/$defs/id" }, "blanks": false, "tolerance": false, "input": false, "unit_label": false } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "numeric_input": {
      "type": "object",
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 6 }
      },
      "additionalProperties": false
    }
  }
}
