{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:udl-content-spec:v1:generators/math/congruent-triangles/params",
  "title": "math.congruent-triangles 參數",
  "description": "形狀由本 schema 檢查；值是否在條件檔範圍內由 checkParams 檢查。通常呼叫 resolveParams 取得。",
  "type": "object",
  "required": [
    "tiers",
    "rotate"
  ],
  "properties": {
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:udl-content-spec:v1:common#/$defs/id"
      },
      "uniqueItems": true
    },
    "weights": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:udl-content-spec:v1:common#/$defs/id"
      },
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "rotate": {
      "type": "boolean",
      "description": "候選與乙隨機轉（15 度一格）；關掉時全等的那一個固定轉 90 度（找全等）或 180 度（找對應）。"
    }
  },
  "additionalProperties": false
}
