{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:udl-content-spec:v1:generators/math/angle-sum/params",
  "title": "math.angle-sum 參數",
  "description": "形狀由本 schema 檢查；值是否在條件檔範圍內由 checkParams 檢查。通常呼叫 resolveParams 取得。",
  "type": "object",
  "required": [
    "tiers",
    "rotate",
    "distinct"
  ],
  "properties": {
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:udl-content-spec:v1:common#/$defs/id"
      },
      "uniqueItems": true
    },
    "weights": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:udl-content-spec:v1:common#/$defs/id"
      },
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "rotate": {
      "type": "boolean",
      "description": "整張圖隨機旋轉（15 度一格）。"
    },
    "distinct": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
