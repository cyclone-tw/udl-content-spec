{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:udl-content-spec:v1:question-types/handwrite/response",
  "title": "手寫字作答",
  "description": "外殼判筆後回報的每個字結果，依題目 target 的順序一字一筆。",
  "type": "object",
  "required": ["chars"],
  "properties": {
    "chars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["char", "completed", "mistakes", "helped"],
        "properties": {
          "char": { "type": "string", "minLength": 1, "maxLength": 1, "description": "這一格要寫的字（照抄 target 的那個字）。" },
          "completed": { "type": "boolean", "description": "有沒有把整個字寫完。" },
          "mistakes": { "type": "integer", "minimum": 0, "description": "寫錯的筆數（外殼判筆）。" },
          "helped": { "type": "boolean", "description": "自己寫的時候有沒有偷看範字或看筆順。" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
